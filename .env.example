# Copy to .env.local for local development (`vercel env pull .env.local` fills
# most of these once the Vercel project is set up). Never commit real values.

# Postgres. Set automatically on Vercel by the Neon integration.
DATABASE_URL=

# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=
